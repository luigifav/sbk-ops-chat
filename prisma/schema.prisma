generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

model Message {
  id                   String   @id @default(cuid())
  question             String
  answer               String
  sessionId            String
  responseTimeMs       Int
  createdAt            DateTime @default(now())
  operatorName         String   @default("Anônimo")
  theme                String?
  inputTokens          Int?
  outputTokens         Int?
  cacheReadTokens      Int?
  cacheCreationTokens  Int?
  // Parcela de cacheCreationTokens gravada com TTL de 1 h, que custa 2,00x da
  // entrada contra 1,25x dos 5 min padrão. cacheCreationTokens continua sendo o
  // total: esta coluna é o recorte de 1 h dentro dele, e a parcela de 5 min sai
  // por subtração (ver splitCacheCreation em lib/pricing.ts). Nulo nas linhas
  // gravadas antes do TTL de 1 h existir, que são integralmente de 5 min.
  cacheCreation1hTokens Int?
  detectedClient       String?
  feedback             Int?
  ragFallback          Boolean  @default(false)
  ragTopScore          Float?
  // Modelo que atendeu a mensagem. Nulo nas linhas gravadas antes desta
  // coluna existir — o dashboard as precifica com LEGACY_MESSAGE_MODEL
  // (ver lib/pricing.ts).
  model                String?
  // Motivo de parada. Valores da API ('end_turn', 'max_tokens',
  // 'stop_sequence', ...) mais dois marcadores locais gravados quando a
  // requisição não chega ao fim: 'timeout' (abort por STREAM_TIMEOUT_MS) e
  // 'error'. Nulo nas linhas anteriores a esta coluna.
  stopReason           String?

  // COMPOSIÇÃO DO PROMPT. Tamanho de cada bloco do system, em CARACTERES.
  //
  // Existem porque o custo por mensagem já era medido, mas de forma agregada:
  // dava para ver que uma mensagem gastou 35 mil tokens de entrada e não de qual
  // bloco eles vieram. Como cada bloco tem uma alavanca de redução diferente, e
  // com risco de qualidade diferente, sem esta quebra qualquer decisão sobre o
  // que encolher é chute. Preenchidas no mesmo INSERT que já existia: nenhuma
  // chamada de API a mais.
  //
  // Caracteres, e não tokens, porque contar tokens exigiria uma chamada de API
  // por mensagem. Para português a razão fica em torno de 3,5 caracteres por
  // token. Nulas nas linhas gravadas antes destas colunas existirem.
  fixedChars           Int?
  clientChars          Int?
  fallbackChars        Int?
  historyChars         Int?
  // O cap de 80.000 caracteres cortou documentação nesta mensagem. Quando é
  // true, o modelo respondeu com documentação incompleta sob a instrução de
  // exclusividade documental, sem saber que faltava material.
  contextCapHit        Boolean?
}

model Setting {
  key   String @id
  value String
}

model Document {
  id              String          @id @default(cuid())
  name            String
  content         String
  type            String
  sizeBytes       Int
  active          Boolean         @default(true)
  order           Int             @default(0)
  createdAt       DateTime        @default(now())
  embeddingStatus String          @default("pending")
  category        String          @default("geral")
  chunks          DocumentChunk[]

  // Filtro das três leituras de Document que toda requisição de chat faz:
  // instruções fixas, instruções do cliente efetivo e o dump do fallback.
  // Declarado aqui, e não só no SQL da migração, para que o schema e o banco não
  // fiquem em drift e um `migrate dev` futuro não proponha derrubar o índice.
  @@index([active, category])
}

model DocumentChunk {
  id         String                      @id @default(cuid())
  documentId String
  document   Document                    @relation(fields: [documentId], references: [id], onDelete: Cascade)
  content    String
  embedding  Unsupported("vector(1024)")?
  chunkIndex Int
  createdAt  DateTime                    @default(now())

  @@index([documentId])
}

model Operator {
  id        String   @id @default(cuid())
  name      String
  password  String
  active    Boolean  @default(true)
  status    String   @default("active")
  clients   String[] @default([])
  createdAt DateTime @default(now())
}
