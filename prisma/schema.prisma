generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

model Message {
  id                   String   @id @default(cuid())
  question             String
  answer               String
  sessionId            String
  responseTimeMs       Int
  createdAt            DateTime @default(now())
  operatorName         String   @default("Anônimo")
  theme                String?
  inputTokens          Int?
  outputTokens         Int?
  cacheReadTokens      Int?
  cacheCreationTokens  Int?
  detectedClient       String?
  feedback             Int?
  ragFallback          Boolean  @default(false)
  ragTopScore          Float?
  // Modelo que atendeu a mensagem. Nulo nas linhas gravadas antes desta
  // coluna existir — o dashboard as precifica com LEGACY_MESSAGE_MODEL
  // (ver lib/pricing.ts).
  model                String?
  // Motivo de parada. Valores da API ('end_turn', 'max_tokens',
  // 'stop_sequence', ...) mais dois marcadores locais gravados quando a
  // requisição não chega ao fim: 'timeout' (abort por STREAM_TIMEOUT_MS) e
  // 'error'. Nulo nas linhas anteriores a esta coluna.
  stopReason           String?
}

model Setting {
  key   String @id
  value String
}

model Document {
  id              String          @id @default(cuid())
  name            String
  content         String
  type            String
  sizeBytes       Int
  active          Boolean         @default(true)
  order           Int             @default(0)
  createdAt       DateTime        @default(now())
  embeddingStatus String          @default("pending")
  category        String          @default("geral")
  chunks          DocumentChunk[]
}

model DocumentChunk {
  id         String                      @id @default(cuid())
  documentId String
  document   Document                    @relation(fields: [documentId], references: [id], onDelete: Cascade)
  content    String
  embedding  Unsupported("vector(1024)")?
  chunkIndex Int
  createdAt  DateTime                    @default(now())

  @@index([documentId])
}

model Operator {
  id        String   @id @default(cuid())
  name      String
  password  String
  active    Boolean  @default(true)
  status    String   @default("active")
  clients   String[] @default([])
  createdAt DateTime @default(now())
}
