# ============================================================
# SBK Ops Chat — Environment Variables
# Copy this file to .env.local and fill in the values.
# NEVER commit .env.local to version control.
# ============================================================

# --- Database -----------------------------------------------
# Primary connection string (pooled, used by Prisma at runtime)
DATABASE_URL=postgresql://user:password@host:5432/dbname

# Direct / unpooled connection for Prisma Migrate and schema introspection.
# Required by Vercel Postgres / Neon; may be the same as DATABASE_URL for
# self-hosted PostgreSQL without a connection pooler.
DATABASE_URL_UNPOOLED=postgresql://user:password@host:5432/dbname

# --- AI APIs ------------------------------------------------
# Anthropic API key (Claude models — chat + document classification)
ANTHROPIC_API_KEY=sk-ant-api03-...

# Voyage AI API key (voyage-3 embeddings for RAG)
VOYAGE_API_KEY=pa-...

# --- Authentication -----------------------------------------
# Shared password that all operators use to authenticate.
# Used as the HMAC message when generating sbk_auth_token.
ACCESS_PASSWORD=escolha-uma-senha-forte

# Admin panel password.
# Used as the HMAC message when generating sbk_admin_token.
ADMIN_PASSWORD=escolha-uma-senha-admin-forte

# HMAC signing secret for cookies.
# MUST be at least 32 characters — the app will refuse to start otherwise.
# Generate with: openssl rand -hex 32
AUTH_SECRET=gere-uma-string-aleatoria-de-pelo-menos-32-caracteres-aqui

# Single-use invite code for operator self-registration.
# Keep this secret; anyone with this code can create a (pending) account.
# Rotate if you suspect it has been leaked.
INVITE_CODE=codigo-de-convite-sbk

# --- Rate limiting --------------------------------------------
# Upstash Redis (or Vercel KV, which is Upstash-backed) REST credentials.
# Required in production so the rate limiter (lib/ratelimit.ts) is enforced
# correctly across concurrent serverless instances. Without these, the app
# falls back to an in-memory counter that is NOT shared across instances.
# Create a database at https://console.upstash.com/ (or via Vercel's
# Marketplace > Upstash integration) and copy the REST URL/token here.
UPSTASH_REDIS_REST_URL=https://your-db.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-rest-token

# Teto diário de mensagens de chat por operador (janela de 24 h), somado ao
# limite horário. Existe para conter gasto acidental, como um script deixado
# rodando: o limite horário sozinho permite 1.440 mensagens por dia.
# Opcional; sem esta variável o padrão é 250.
CHAT_DAILY_LIMIT=250

# Teto horário de mensagens de chat por operador. Opcional; padrão 60.
# Só vale a pena mexer na instância que roda o harness de avaliação
# (evals/, issue #60): um conjunto de 40 a 60 casos estoura 60 por hora e a
# rodada morre no meio. NÃO aumentar em produção sem motivo, é o limite que
# contém o custo da API.
CHAT_HOURLY_LIMIT=60

# --- Parâmetros de geração do chat -----------------------------
# Não são variáveis de ambiente: ficam na tabela `Setting`, editável pelo painel
# de admin, para permitir ajuste sem deploy. Listados aqui só como referência.
# Todos opcionais; ausentes, valem os defaults de lib/chatTuning.ts, que
# reproduzem o comportamento anterior à issue #65.
#
#   chat_effort_simple        low|medium|high|max         (default high)
#   chat_effort_petition      low|medium|high|max         (default high)
#   chat_max_tokens_simple    256 a 8192                  (default 2048)
#   chat_max_tokens_petition  256 a 8192                  (default 2048)
#   theme_classifier          heuristic|llm               (default heuristic)
#
# ATENÇÃO ao effort: `xhigh` não está na lista acima por opção, não por
# limitação do modelo atual — o Sonnet 5 (CHAT_MODEL) aceita `xhigh`, mas
# habilitá-lo no painel exige revisar TUNING_DEFAULTS e o harness da #60
# primeiro (ver lib/chatTuning.ts). Gravar `xhigh` no painel hoje cai no
# default com aviso no log; ao trocar de modelo, revise a lista de
# VALID_EFFORTS em lib/chatTuning.ts contra os níveis do modelo novo.
#
# Baixar chat_effort_simple é a maior economia disponível, porque as perguntas
# simples dominam o volume e saída custa 5x a entrada. Mas a issue #65 manda
# escolher pelo par acerto e custo medido no harness da #60, não pelo custo
# isolado. Não mexer antes de ter esse número.

# --- RAG health alerting (optional) ----------------------------
# Reaproveita o Redis acima (lib/ragHealth.ts) para monitorar a taxa de
# fallback do RAG em janelas de 15 min. Sem UPSTASH_REDIS_REST_URL/TOKEN
# configurados, o monitor fica inativo (só os logs por requisição continuam).
# Webhook opcional (compatível com Slack/Discord/Teams incoming webhook) para
# onde enviar o alerta quando a taxa de fallback ultrapassar 70% com amostra
# mínima de 15 mensagens na janela. Sem isso, o alerta só aparece nos logs.
RAG_ALERT_WEBHOOK_URL=https://hooks.slack.com/services/your/webhook/url
